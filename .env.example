# Flask Backend Configuration
FLASK_ENV=development
FLASK_APP=app:create_app
PORT=5000
HOST=127.0.0.1
FLASK_DEBUG=false

# Security & Secrets
# In production, replace SECRET_KEY with a high-entropy random string (e.g. openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-in-production

# Authentication & JWT
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

# Database Configuration (Neon PostgreSQL with pgvector)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Storage & Upload Bounds
STORAGE_ROOT=data/documents
MAX_UPLOAD_SIZE_BYTES=20971520

# OCR & Processing
OCR_PROVIDER=mock

# Embedding & Retrieval
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-minilm-384

# Security & CORS
# Comma-separated list of allowed origins (restrictive by default)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000
